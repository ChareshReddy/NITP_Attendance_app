datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EMPLOYEE
  TL
  HR_ADMIN
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HOLIDAY
  WEEK_OFF
  LATE_COMING
  EARLY_LEAVING
  OVERTIME
  MISSING_PUNCH
}

enum TrackSheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          Role           @default(EMPLOYEE)
  isActive      Boolean        @default(true) @map("is_active")
  teamId        String?        @map("team_id")
  managerId     String?        @map("manager_id")
  team          Team?          @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  manager       User?          @relation("ManagerToEmployee", fields: [managerId], references: [id], onDelete: SetNull)
  employees     User[]         @relation("ManagerToEmployee")
  attendance    Attendance[]
  trackSheets   TrackSheet[]
  assignedTasks Task[]         @relation("AssignedTo")
  createdTasks  Task[]         @relation("AssignedBy")
  reports       Report[]       @relation("ReportSubmittedBy")
  hrReports     Report[]       @relation("ReportSubmittedTo")
  notifications Notification[]
  auditLogs     AuditLog[]
  passwordResets PasswordReset[]
  ledTeams      Team[]         @relation("TeamLeader")

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  performanceScore      PerformanceScore?  @relation("UserPerformance")
  performanceUpdates    PerformanceScore[] @relation("PerformanceUpdatedBy")
  leaveRequests         LeaveRequest[]     @relation("UserLeaveRequests")
  reviewedLeaveRequests LeaveRequest[]     @relation("LeaveReviewer")
  employeeProfile       EmployeeProfile?
  salaryStructure       SalaryStructure?
  payrollRuns           PayrollRun[]
  goals                 PerformanceGoal[]  @relation("UserGoals")
  managedGoals          PerformanceGoal[]  @relation("GoalManager")
  trainingAttendance    TrainingAttendance[]
  resignationRequest     ResignationRequest?
  regularisationRequests RegularisationRequest[]

  @@map("users")
}

model Team {
  id           String   @id @default(uuid())
  name         String
  teamLeaderId String?  @map("team_leader_id")
  teamLeader   User?    @relation("TeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  members      User[]   @relation("TeamMembers")
  tasks        Task[]
  reports      Report[]

  @@map("teams")
}

model Attendance {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String           // YYYY-MM-DD
  checkInTime  DateTime?        @map("check_in_time")
  checkOutTime DateTime?        @map("check_out_time")
  status       AttendanceStatus
  ip           String
  tz           String           // e.g., "Asia/Kolkata" or "UTC"
  
  @@unique([userId, date])
  @@map("attendance")
}

model TrackSheet {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String           // YYYY-MM-DD
  project         String
  taskDescription String           @map("task_description")
  hours           Float
  status          TrackSheetStatus @default(PENDING)
  notes           String?
  assignedByName  String?          @map("assigned_by_name")
  tlComment       String?          @map("tl_comment")
  supportingDocuments String?       @map("supporting_documents")
  referenceLink       String?       @map("reference_link")
  
  @@index([userId, date])
  @@index([project])
  @@map("track_sheets")
}

model Task {
  id           String     @id @default(uuid())
  teamId       String?    @map("team_id")
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedById String     @map("assigned_by")
  assignedBy   User       @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedToId String     @map("assigned_to")
  assignedTo   User       @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  title        String
  description  String
  dueDate      DateTime   @map("due_date")
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(TODO)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([assignedToId, status])
  @@index([teamId])
  @@map("tasks")
}

model Report {
  id                String       @id @default(uuid())
  teamId            String       @map("team_id")
  team              Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedById     String       @map("submitted_by")
  submittedBy       User         @relation("ReportSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedToUserId String       @map("submitted_to_user_id")
  submittedTo       User         @relation("ReportSubmittedTo", fields: [submittedToUserId], references: [id], onDelete: Cascade)
  periodStart       DateTime     @map("period_start")
  periodEnd         DateTime     @map("period_end")
  summary           String
  status            ReportStatus @default(PENDING)
  createdAt         DateTime     @default(now()) @map("created_at")

  @@map("reports")
}

model LeaveType {
  id          String         @id @default(uuid())
  name        String         @unique
  daysAllowed Int            @map("days_allowed")
  requests    LeaveRequest[] @relation("TypeRequests")

  @@map("leave_types")
}

model Holiday {
  id   String @id @default(uuid())
  date String @unique // Standardized to String YYYY-MM-DD
  name String

  @@map("holidays")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  @@map("password_resets")
}

enum PerformanceRating {
  RED
  YELLOW
  GREEN
  BLUE
}

model PerformanceScore {
  id             String            @id @default(uuid())
  userId         String            @unique @map("user_id")
  user           User              @relation("UserPerformance", fields: [userId], references: [id], onDelete: Cascade)
  rating         PerformanceRating @default(GREEN)
  autoScore      Float             @map("auto_score")
  overrideScore  Float?            @map("override_score")
  manualOverride Boolean           @default(false) @map("manual_override")
  overrideReason String?           @map("override_reason")
  updatedById    String?           @map("updated_by_id")
  updatedBy      User?             @relation("PerformanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("performance_scores")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  user         User               @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId  String             @map("leave_type_id")
  leaveType    LeaveType          @relation("TypeRequests", fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate    String             @map("start_date") // YYYY-MM-DD
  endDate      String             @map("end_date") // YYYY-MM-DD
  reason       String
  status       LeaveRequestStatus @default(PENDING)
  reviewedById String?            @map("reviewed_by_id")
  reviewedBy   User?              @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?          @map("reviewed_at")
  lossOfPay    Boolean            @default(false) @map("loss_of_pay")
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("leave_requests")
}

model EmployeeProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth       DateTime? @map("date_of_birth")
  gender            String?
  maritalStatus     String?  @map("marital_status")
  nationality       String?
  personalEmail     String?  @map("personal_email")
  mobileNumber      String?  @map("mobile_number")
  emergencyContact  String?  @map("emergency_contact")
  permanentAddress  String?  @map("permanent_address")
  currentAddress    String?  @map("current_address")
  dateOfJoining     DateTime? @map("date_of_joining")
  employeeType      String?  @map("employee_type") // Full-time, Contract, Intern
  department        String?
  designation       String?
  grade             String?
  location          String?
  workLocationStatus String?  @map("work_location_status")
  businessUnit      String?  @map("business_unit")
  hrBusinessPartner String?  @map("hr_business_partner")
  employmentStatus  String?  @default("Active") @map("employment_status")
  probationPeriod   Int?     @map("probation_period_months")
  confirmationDate  DateTime? @map("confirmation_date")
  workShift         String?  @map("work_shift")
  bankName          String?  @map("bank_name")
  accountNumber     String?  @map("account_number")
  ifsc              String?
  pan               String?
  panEncrypted      Boolean  @default(false)
  uan               String?
  professionalEmail String?  @map("professional_email")
  insuranceNumber   String?  @map("insurance_number")
  pfNumber          String?  @map("pf_number")
  bankAddress       String?  @map("bank_address")
  bankBranch        String?  @map("bank_branch")
  expectedEndDate   DateTime? @map("expected_end_date")
  incrementPerks    String?  @map("increment_perks")
  bloodGroup        String?  @map("blood_group")
  profileImage      String?  @map("profile_image")
  timezone          String?  @default("Asia/Kolkata") @map("timezone")
  financialDocuments String?  @map("financial_documents")
  updatedAt         DateTime @updatedAt @map("updated_at")
  @@map("employee_profiles")
}

model SalaryStructure {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  basicSalary     Float    @map("basic_salary")
  hra             Float
  conveyance      Float
  specialAllowance Float   @map("special_allowance")
  effectiveFrom   DateTime @map("effective_from")
  @@map("salary_structures")
}

model PayrollRun {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  basicSalary     Float    @map("basic_salary")
  hra             Float
  conveyance      Float
  specialAllowance Float   @map("special_allowance")
  bonus           Float    @default(0)
  incentives      Float    @default(0)
  overtime        Float    @default(0)
  grossEarnings   Float    @map("gross_earnings")
  pf              Float
  esi             Float
  professionalTax Float    @map("professional_tax")
  tds             Float
  loanDeduction   Float    @default(0) @map("loan_deduction")
  lopDeduction    Float    @default(0) @map("lop_deduction")
  totalDeductions Float    @map("total_deductions")
  netSalary       Float    @map("net_salary")
  status          String   @default("DRAFT") // DRAFT, APPROVED, PAID
  generatedAt     DateTime @default(now()) @map("generated_at")
  @@unique([userId, periodStart, periodEnd])
  @@map("payroll_runs")
}

model PerformanceGoal {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation("UserGoals", fields: [userId], references: [id], onDelete: Cascade)
  managerId    String   @map("manager_id")
  manager      User     @relation("GoalManager", fields: [managerId], references: [id])
  goalTitle    String   @map("goal_title")
  kpi          String
  weight       Float
  target       String
  achievement  String?
  rating       Float?
  period       String
  status       String   @default("DRAFT") // DRAFT, MANAGER_APPROVED, MID_YEAR, YEAR_END, HR_REVIEWED
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("performance_goals")
}

model Training {
  id              String   @id @default(uuid())
  trainingName    String   @map("training_name")
  trainer         String
  plannedDate     DateTime @map("planned_date")
  actualDate      DateTime? @map("actual_date")
  durationHours   Float    @map("duration_hours")
  department      String?
  attendance      TrainingAttendance[]
  @@map("trainings")
}

model TrainingAttendance {
  id             String    @id @default(uuid())
  trainingId     String    @map("training_id")
  training       Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attended       Boolean   @default(false)
  assessmentScore Float?   @map("assessment_score")
  certified      Boolean   @default(false)
  feedback       String?
  @@unique([trainingId, userId])
  @@map("training_attendance")
}

model ResignationRequest {
  id              String             @id @default(uuid())
  userId          String             @unique @map("user_id")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resignationDate DateTime           @map("resignation_date")
  lastWorkingDay  DateTime           @map("last_working_day")
  reason          String
  status          String             @default("PENDING") // PENDING, APPROVED, REJECTED
  hrNotes         String?            @map("hr_notes")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  @@map("resignation_requests")
}

model RegularisationRequest {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String             // YYYY-MM-DD
  checkInTime     String?            @map("check_in_time")
  checkOutTime    String?            @map("check_out_time")
  reason          String
  status          String             @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById    String?            @map("reviewed_by_id")
  reviewedAt      DateTime?          @map("reviewed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  @@map("regularisation_requests")
}
