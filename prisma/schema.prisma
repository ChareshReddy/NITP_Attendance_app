datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EMPLOYEE
  TL
  HR_ADMIN
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

enum TrackSheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          Role           @default(EMPLOYEE)
  isActive      Boolean        @default(true) @map("is_active")
  teamId        String?        @map("team_id")
  managerId     String?        @map("manager_id")
  team          Team?          @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  manager       User?          @relation("ManagerToEmployee", fields: [managerId], references: [id], onDelete: SetNull)
  employees     User[]         @relation("ManagerToEmployee")
  attendance    Attendance[]
  trackSheets   TrackSheet[]
  assignedTasks Task[]         @relation("AssignedTo")
  createdTasks  Task[]         @relation("AssignedBy")
  reports       Report[]       @relation("ReportSubmittedBy")
  hrReports     Report[]       @relation("ReportSubmittedTo")
  notifications Notification[]
  auditLogs     AuditLog[]
  passwordResets PasswordReset[]
  ledTeams      Team[]         @relation("TeamLeader")

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Team {
  id           String   @id @default(uuid())
  name         String
  teamLeaderId String?  @map("team_leader_id")
  teamLeader   User?    @relation("TeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  members      User[]   @relation("TeamMembers")
  tasks        Task[]
  reports      Report[]

  @@map("teams")
}

model Attendance {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String           // YYYY-MM-DD
  checkInTime  DateTime         @map("check_in_time")
  checkOutTime DateTime?        @map("check_out_time")
  status       AttendanceStatus
  ip           String
  tz           String           // e.g., "Asia/Kolkata" or "UTC"
  
  @@unique([userId, date])
  @@map("attendance")
}

model TrackSheet {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String           // YYYY-MM-DD
  project         String
  taskDescription String           @map("task_description")
  hours           Float
  status          TrackSheetStatus @default(PENDING)
  notes           String?
  
  @@index([userId, date])
  @@index([project])
  @@map("track_sheets")
}

model Task {
  id           String     @id @default(uuid())
  teamId       String?    @map("team_id")
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedById String     @map("assigned_by")
  assignedBy   User       @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedToId String     @map("assigned_to")
  assignedTo   User       @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  title        String
  description  String
  dueDate      DateTime   @map("due_date")
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(TODO)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([assignedToId, status])
  @@index([teamId])
  @@map("tasks")
}

model Report {
  id                String       @id @default(uuid())
  teamId            String       @map("team_id")
  team              Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedById     String       @map("submitted_by")
  submittedBy       User         @relation("ReportSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedToUserId String       @map("submitted_to_user_id")
  submittedTo       User         @relation("ReportSubmittedTo", fields: [submittedToUserId], references: [id], onDelete: Cascade)
  periodStart       DateTime     @map("period_start")
  periodEnd         DateTime     @map("period_end")
  summary           String
  status            ReportStatus @default(PENDING)
  createdAt         DateTime     @default(now()) @map("created_at")

  @@map("reports")
}

model LeaveType {
  id          String @id @default(uuid())
  name        String @unique
  daysAllowed Int    @map("days_allowed")

  @@map("leave_types")
}

model Holiday {
  id   String @id @default(uuid())
  date String @unique // Standardized to String YYYY-MM-DD
  name String

  @@map("holidays")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  @@map("password_resets")
}
